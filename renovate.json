{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeDigest",
    ":automergeMinor",
    ":maintainLockFilesMonthly",
    ":rebaseStalePrs",
    ":semanticCommits",
    ":semanticCommitScope(deps)"
  ],
  "assignees": ["maxbrunet"],
  "internalChecksFilter": "strict",
  "platformAutomerge": true,
  "rangeStrategy": "pin",
  "packageRules": [
    {
      "description": "One week stability period for Rust packages",
      "matchDatasources": ["crate"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Customize rust updates commit message",
      "matchPackageNames": ["rust"],
      "commitMessageTopic": "rust"
    },
    {
      "description": "Group packages from zbus monorepo together",
      "matchSourceUrls": ["https://github.com/dbus2/zbus"],
      "matchUpdateTypes": ["digest", "patch", "minor", "major"],
      "groupName": "zbus"
    },
    {
      "matchDepTypes": ["dependencies"],
      "semanticCommitType": "build"
    }
  ],
  "customDatasources": {
    "riscv-runners": {
      "description": "RISE RISC-V runner labels track the ubuntu os-versions in the riscv-runner build matrix",
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/riseproject-dev/riscv-runner/main/.github/workflows/deploy-runner.yml",
      "format": "yaml",
      "transformTemplates": [
        "{'releases': jobs.`build-images`.strategy.matrix.include.{'version': `os-version` & '-riscv'}, 'sourceUrl': 'https://github.com/riseproject-dev/riscv-runner', 'homepage': 'https://riscv-runners.riseproject.dev/'}"
      ]
    }
  },
  "customManagers": [
    {
      "description": "Update version keys in YAML files",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/).*.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>[^\\s]+?)(?: packageName=(?<packageName>[^\\s]+?))?(?: versioning=(?<versioning>[a-z-0-9]+?))?\\s*[\\w-_]*(?:version|VERSION): (?<currentValue>.*?)\\s"
      ]
    },
    {
      "description": "Update semantic-release plugins",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/build\\.yml$/"],
      "matchStrings": ["\\s{12}(?<depName>\\S+?)@(?<currentValue>.+?)\\s"],
      "datasourceTemplate": "npm"
    },
    {
      "description": "Update Rust stable version in rust-toolchain.toml",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)rust-toolchain\\.toml$/"],
      "matchStrings": ["channel\\s*=\\s*('|\")(?<currentValue>.+?)('|\")\\s"],
      "depNameTemplate": "rust",
      "packageNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Update GitHub Actions runner labels in strategy.matrix runs-on",
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": ["/^\\.github/workflows/build\\.yml$/"],
      "matchStrings": [
        "jobs.test.strategy.matrix.`runs-on`[$match($, /^[a-z]+-[0-9]+\\.[0-9]+/)].{ 'depName': $substringBefore($, '-'), 'currentValue': $substringAfter($, '-') }"
      ],
      "datasourceTemplate": "{{#if (containsString currentValue \"-riscv\")}}custom.riscv-runners{{else}}github-runners{{/if}}",
      "versioningTemplate": "docker",
      "depTypeTemplate": "github-runner"
    }
  ]
}
